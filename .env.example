# Copie para .env. Não coloque segredos neste arquivo.
AI_SHORTS_STORAGE_ROOT=../storage
# Omitir AI_SHORTS_DATABASE_PATH usa <storage_root>/metadata.sqlite3.
AI_SHORTS_FFMPEG_BINARY=ffmpeg
AI_SHORTS_FFPROBE_BINARY=ffprobe
AI_SHORTS_FFPROBE_TIMEOUT_SECONDS=30
AI_SHORTS_FFMPEG_TIMEOUT_SECONDS=900
AI_SHORTS_WHISPER_TIMEOUT_SECONDS=7200
AI_SHORTS_MAX_UPLOAD_BYTES=8589934592
AI_SHORTS_MAX_REQUEST_BYTES=8592037888
AI_SHORTS_UPLOAD_CHUNK_BYTES=1048576
AI_SHORTS_MAX_CONCURRENT_UPLOADS=1
AI_SHORTS_REQUEST_BODY_TIMEOUT_SECONDS=60
AI_SHORTS_MIN_FREE_SPACE_BYTES=1073741824
AI_SHORTS_MAX_MEDIA_DURATION_MS=21600000
AI_SHORTS_PROBE_WORKERS=1
AI_SHORTS_JOB_WORKERS=1
AI_SHORTS_JOB_SHUTDOWN_TIMEOUT_SECONDS=5
AI_SHORTS_MAX_ACTIVE_JOBS=4
AI_SHORTS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
AI_SHORTS_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]
